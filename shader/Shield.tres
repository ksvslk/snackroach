[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform vec4 color: hint_color = vec4(1.0);
uniform float outer_radius: hint_range(0.0, 1.0, 0.01) = 0.35;
uniform float outer_feather: hint_range(0.0, 1.0, 0.01) = 0.01;

uniform float inner_radius: hint_range(0.0, 1.0, 0.01) = 0.275;
uniform float inner_feather: hint_range(0.0, 1.0, 0.01) = 0.1;
uniform float inner_fade: hint_range(0.0, 1.0, 0.01) = 0.01;


float circle(vec2 position, float radius, float feather)
{
	return smoothstep(radius, radius + feather, length(position - vec2(0.5)));
}


void fragment(){
	float outer = circle(vec2(UV.x, UV.y), outer_radius, outer_feather);
	float fade_effect = sin(TIME) * 0.01;
	float inner = 1.0 - circle(vec2(UV.x, UV.y), inner_radius, inner_feather - fade_effect );
	COLOR = color;
	COLOR.a -= outer + inner;
}
"

[resource]
shader = SubResource( 1 )
shader_param/color = Color( 0, 0.952941, 1, 1 )
shader_param/outer_radius = 0.441
shader_param/outer_feather = 0.059
shader_param/inner_radius = 0.045
shader_param/inner_feather = 0.75
shader_param/inner_fade = 0.01
