[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="roach"
2d_physics/layer_2="throwable"
2d_physics/layer_3="floor"
2d_physics/layer_4="wall"
2d_physics/layer_5="food"
2d_physics/layer_6="pit"
2d_physics/layer_7="roof"
2d_physics/layer_8="second_floor"
2d_physics/layer_9="honey"
2d_physics/layer_10="leg"
2d_physics/layer_11="onoff"
2d_physics/layer_12="laser"
2d_physics/layer_13="roach_big"
2d_physics/layer_14="enemy"
2d_physics/layer_15="enemy_big"
2d_physics/layer_16="enemy_leg"
2d_physics/layer_17="obstacle"
2d_physics/layer_18="checkpoint"
2d_physics/layer_19="moving_floor"
2d_physics/layer_20="alcohol"
2d_physics/layer_21="black_hole"
2d_physics/layer_22="light_switch"

[locale]

translations=PoolStringArray( "res://translations/translations.de.translation", "res://translations/translations.en.translation", "res://translations/translations.es.translation", "res://translations/translations.et.translation", "res://translations/translations.fi.translation", "res://translations/translations.fr.translation", "res://translations/translations.hi.translation", "res://translations/translations.id.translation", "res://translations/translations.it.translation", "res://translations/translations.ja.translation", "res://translations/translations.ko.translation", "res://translations/translations.pt.translation", "res://translations/translations.th.translation", "res://translations/translations.vi.translation", "res://translations/translations.ar.translation", "res://translations/translations.ms.translation", "res://translations/translations.nb.translation", "res://translations/translations.ru.translation", "res://translations/translations.sv.translation", "res://translations/translations.tr.translation", "res://translations/translations.zh_Hans_CN.translation" )

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=0
2d/snapping/use_gpu_pixel_snap=true
threads/thread_model=2
vram_compression/import_etc=true
vram_compression/import_pvrtc=true
quality/reflections/texture_array_reflections=false
quality/reflections/high_quality_ggx=false
quality/shading/force_blinn_over_ggx=true
quality/filters/anisotropic_filter_level=2
quality/filters/use_nearest_mipmap_filter=true
quality/skinning/software_skinning_fallback=false
quality/spatial_partitioning/render_tree_balance=1.0
gles2/compatibility/disable_half_float=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
quality/filters/use_fxaa=true
quality/depth/hdr=false
environment/default_environment="res://default_env.tres"
