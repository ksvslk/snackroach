[application]

config/name="Snackroach"
run/main_scene="res://Master.tscn"
config/custom_user_dir_name="SaveRoach"
boot_splash/image="res://icon/256.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon/icon_main.png"
config/macos_native_icon="res://icon/Icon.icns"
config/windows_native_icon="res://icon/icon_all.ico"

[autoload]

GPack="*res://scripts/gpack.gd"
C="*res://scripts/c.gd"
Data="*res://scripts/data.gd"

[debug]

gdscript/warnings/narrowing_conversion=false
gdscript/warnings/return_value_discarded=false
gdscript/warnings/integer_division=false
gdscript/warnings/unsafe_call_argument=true

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1920
window/size/test_height=1080
mouse_cursor/custom_image="res://graphics/cursor2.png"
mouse_cursor/custom_image_hotspot=Vector2( 25, 25 )
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray(  )

[global]

joystick=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

