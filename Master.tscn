[sub_resource type="GDScript" id=56]
script/source = "extends HSlider

export var audio_bus_name := \"Music\"
onready var volume_down = $\"../VolumeDown\"
onready var volume_up = $\"../VolumeUp\"
onready var select = $\"../../../../../SelectEffect\"

onready var _bus := AudioServer.get_bus_index(audio_bus_name)

func _ready() -> void:
	value = _get_current_volume()
	AudioServer.set_bus_volume_db(_bus, linear2db(value))
	if value == 0:
		volume_down.texture = load(\"res://icon/sound_off.png\")
	else:
		volume_down.texture = load(\"res://icon/volume_down.png\")
		

func _on_HSlider_value_changed(value: float):
	if value == 0:
		volume_down.texture = load(\"res://icon/sound_off.png\")
	else:
		volume_down.texture = load(\"res://icon/volume_down.png\")
	AudioServer.set_bus_volume_db(_bus, linear2db(value))
	_set_new_volume(value)
	select.play()


func _set_new_volume(new_volume:float) -> void:
	if audio_bus_name == \"Music\":
		Data.set_music_volume(new_volume)
	elif audio_bus_name == \"SFX\":
		Data.set_sound_volume(new_volume)
		

func _get_current_volume() -> float:
	if audio_bus_name == \"Music\":
		return Data.get_music_volume()
	else:
		return Data.get_sound_volume()


func _on_HSlider_mouse_exited():
	release_focus()
"

